import random
class BankAccount:
    def __init__(self, name, balance,otp):
        self.name = name
        self._account_type = "Saving"
        self.__balance = balance
        self.otp=otp

    def deposit(self, amount):
        self.__balance =  self.__balance+amount  #12000
        print(f"Deposited {amount}")

    def withdraw(self, amount):
        if self.__verify_pin():
            if amount <= self.__balance:
                self.__balance = self.__balance-amount
                print(f"Withdrew {amount}")
            else:
                print("Insufficient funds")
        else:
            print("PIN verification failed")

    def get_balance(self):
        return self.__balance

    def _calculate_interest(self):
        interest = self.__balance * 0.05
        print(f"Interest: {interest}")

    def __verify_pin(self):
        genotp=random.randint(1000,9999)
        print("generated otp=",genotp)
        self.otp=genotp
        userotp=int(input("enter a otp value"))
        if self.otp==userotp:
            return True
        else:
            return False


acc = BankAccount("Suresh", 10000,0)
print("Account holder:", acc.name) #suresh
print("Account type (protected):", acc._account_type) #savings
acc.deposit(2000)
acc.withdraw(3000)
acc._calculate_interest()
print("Balance:", acc.get_balance())


